# Lodera environment configuration.
# Copy to `.env` (git-ignored) and adjust as needed. Never commit real secrets.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=lodera
POSTGRES_PASSWORD=lodera
POSTGRES_DB=lodera

# ---------------------------------------------------------------------------
# Backend (FastAPI) — variables are read with the LODERA_ prefix
# ---------------------------------------------------------------------------
LODERA_ENVIRONMENT=development
# SQLAlchemy DSN. Host `db` is the Compose service name; matches POSTGRES_* above.
LODERA_DATABASE_URL=postgresql+psycopg://lodera:lodera@db:5432/lodera

# ---------------------------------------------------------------------------
# Frontend (Vite) — base URL the browser uses to reach the backend API
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# Optional: override the user-facing product name without code changes.
# Backend equivalent is LODERA_APP_NAME (defaults to "Lodera API").
# VITE_APP_NAME=Lodera
# LODERA_APP_NAME=Lodera API
